# Copie para .env e troque os valores:  cp .env.example .env
# Dica para gerar valores aleatórios:   openssl rand -hex 32

# Senha do banco de dados (Postgres)
DB_PASSWORD=troque-esta-senha

# Chave secreta dos logins (mínimo 16 caracteres)
JWT_SECRET=troque-esta-chave-secreta-bem-longa

# Porta onde o Nexo vai abrir (8080 já é do Jenkins)
APP_PORT=3000

# Tamanho máximo de cada anexo, em MB
MAX_UPLOAD_MB=8

# ---- Fase 3 (voz/vídeo e HTTPS) ----
# IP do servidor (o mesmo que você usa no navegador)
NEXO_HOST=192.168.100.10

# Chaves do LiveKit (servidor de voz). O segredo precisa ter 32+ caracteres.
# Dica: rode  bash infra/completar-env.sh  para gerar tudo sozinho.
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres

# Token do bot de exemplo (crie o bot no Nexo: seu nome → Desenvolvedor)
BOT_TOKEN=

# ---- Fase 4 ----
# Backup diário (job nexo-backup no Jenkins). Pasta na VM e quantos dias guardar.
BACKUP_DIR=/var/backups/nexo
BACKUP_KEEP_DAYS=14

# Código exigido para criar conta. Deixe vazio para cadastro livre.
# Recomendado quando o Nexo estiver aberto na internet.
REGISTRATION_CODE=

# Acesso pela internet (domínio + Cloudflare). Veja docs/acesso-externo.md.
# Descomente as duas linhas abaixo só depois de criar o túnel:
# COMPOSE_FILE=docker-compose.yml:docker-compose.publico.yml
# CLOUDFLARE_TUNNEL_TOKEN=cole-o-token-aqui
