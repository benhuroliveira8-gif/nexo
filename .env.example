# Copie para .env e troque os valores:  cp .env.example .env
# Dica para gerar valores aleatórios:   openssl rand -hex 32

# Senha do banco de dados (Postgres)
DB_PASSWORD=troque-esta-senha

# Chave secreta dos logins (mínimo 16 caracteres)
JWT_SECRET=troque-esta-chave-secreta-bem-longa

# Porta onde o Nexo vai abrir (8080 já é do Jenkins)
APP_PORT=3000
