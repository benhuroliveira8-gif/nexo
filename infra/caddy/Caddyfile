# Caddy: dá HTTPS ao Nexo (o navegador só libera microfone/câmera com HTTPS).
# Como é uma rede local, o certificado é gerado pelo próprio Caddy ("tls internal").
{
	local_certs
	skip_install_trust
	# Navegadores não mandam o nome do site quando se acessa por IP; isto resolve.
	default_sni {$NEXO_HOST}
}

https://{$NEXO_HOST}, https://localhost {
	tls internal
	encode gzip
	# Este cabeçalho só pode vir da Cloudflare (pelo túnel); aqui é removido.
	request_header -Cf-Connecting-Ip

	# Sinalização do LiveKit (voz/vídeo) passa pelo mesmo endereço.
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy app:3000
	}
}

http:// {
	redir https://{host}{uri} permanent
}

# Entrada do túnel da Cloudflare (acesso pela internet com domínio próprio).
# Só o container "cloudflared" usa esta porta, por dentro da rede do Docker:
# ela NÃO é aberta na VM. O HTTPS de verdade quem faz é a Cloudflare.
:8080 {
	encode gzip

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy app:3000
	}
}
